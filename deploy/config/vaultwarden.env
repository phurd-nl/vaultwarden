# Vaultwarden non-secret configuration (config-as-code) — NIST 800-53B Moderate.
# Secrets (ADMIN_TOKEN, DATABASE_URL) are NOT here — they come from podman
# secrets via native <KEY>_FILE support (ADMIN_TOKEN_FILE/DATABASE_URL_FILE set
# in the quadlet). Never put secrets in this file.
#
# This is the production source of truth. To avoid config drift (NIST CM-6),
# do NOT also edit settings via the /admin UI; treat config.json as drift.

# ---- Identity / endpoint ----
DOMAIN=https://nextvault.nxlink.com
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8080

# ---- Access control (NIST AC) ----
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
# Lock org creation to nobody: this is a single managed org (Nextlink). Regular
# users (and SSO auto-enrolled users) must not be able to spin up their own orgs.
ORG_CREATION_USERS=none
# Defense-in-depth for SSO auto-provisioning (NIST AC-2): even though SSO account
# creation is gated by what Entra returns, pin the eligible email domain(s) so a
# guest/multi-tenant misconfig can't provision arbitrary accounts. Comma-separated.
SIGNUPS_DOMAINS_WHITELIST=team.nxlink.com,nextlink.team
# Send is disabled: secure sharing/file-sharing is handled by NextPass instead.
# Blocks the Send API for all clients; the web-vault Send nav is also removed in
# our branded build (bw_web_builds rebrand.sh hide-send-nav patch).
SENDS_ALLOWED=false
PASSWORD_ITERATIONS=600000

# ---- Account lockout (NIST AC-7) — fork feature ----
ACCOUNT_LOCKOUT_ENABLED=true
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_COOLDOWN_SECONDS=900

# ---- System-use notification / login banner (NIST AC-8) — fork feature ----
# Rendered on the /admin login page. Also surfaced in GET /api/config as
# "loginBanner", but the stock Bitwarden web/desktop/mobile clients ignore
# unknown config fields, so end-user vault login screens will NOT show it
# without a custom client. The /admin banner is the assessor-facing evidence.
LOGIN_BANNER=AUTHORIZED USE ONLY. Activity on this system is monitored and logged. Unauthorized access is prohibited and may be subject to civil and criminal penalties.

# ---- Session lifetime (NIST AC-11/AC-12) — fork feature ----
# Defaults preserve current behavior. Idle timeout is OFF unless uncommented.
SESSION_REFRESH_VALIDITY_DAYS=30
SESSION_MOBILE_REFRESH_VALIDITY_DAYS=90
# SESSION_IDLE_TIMEOUT_MINUTES=480
ADMIN_SESSION_LIFETIME=20

# ---- Audit logging (NIST AU-2/AU-3/AU-12) — fork feature ----
AUDIT_LOG_ENABLED=true
# Org event log (DB-backed) retained in parallel:
ORG_EVENTS_ENABLED=true
EVENTS_DAYS_RETAIN=365
LOG_LEVEL=info
EXTENDED_LOGGING=true

# ---- SSO / OIDC via Microsoft Entra ID (NIST IA-2/IA-8) — see docs/adr/0005 ----
# SSO_CLIENT_SECRET is NOT here — it is a podman secret read via
# SSO_CLIENT_SECRET_FILE (set in the quadlet). The callback path auto-derives
# from DOMAIN as https://<DOMAIN>/identity/connect/oidc-signin — register THAT
# as the redirect URI in the Entra app registration.
SSO_ENABLED=true
# Rollout: bring up with SSO_ONLY=false, verify an end-to-end Entra login works,
# THEN set SSO_ONLY=true. /admin uses ADMIN_TOKEN separately, so admins are not
# locked out by an IdP outage. Target state is true.
SSO_ONLY=true
# Tenant-scoped v2.0 authority (discovery at <authority>/.well-known/openid-configuration):
SSO_AUTHORITY=https://login.microsoftonline.com/<TENANT_ID>/v2.0
SSO_CLIENT_ID=<ENTRA_APPLICATION_CLIENT_ID>
# offline_access => refresh tokens so sessions persist (no random sign-outs).
SSO_SCOPES=email profile offline_access
SSO_PKCE=true
# Match/auto-link users by verified email from the IdP (requires the Entra
# "email" optional claim — see deploy/VM-BRINGUP.md).
SSO_SIGNUPS_MATCH_EMAIL=true
# Entra does not emit an email_verified claim for work/school accounts, and
# Vaultwarden rejects logins with unknown verification status by default.
# Tenant-managed emails are authoritative, so trusting them is safe here; the
# risk this guards against only applies to public IdPs with self-asserted emails.
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=true
# Auto-enroll every SSO-authenticated user into the Nextlink org as a regular
# User (NIST AC-2 provisioning) — fork feature, see src/sso_enroll.rs. Members
# land in Accepted state and an org Admin must Confirm them (the confirm step
# delivers the org key encrypted to the member's public key; the server never
# holds the org key, so E2EE is preserved). MSP staff are then elevated to Admin
# in the org Members UI; keep one Owner. Empty value disables auto-enrollment.
SSO_DEFAULT_ORG=69db5463-a4a4-4ea2-9535-15cb845c6053

# ---- Egress restriction (NIST SC) ----
# App+DB run on an Internal=true network with no internet egress. Disable all
# outbound fetches so nothing breaks and nothing leaks. Re-enable individually
# only with an approved egress allowlist.
DISABLE_ICON_DOWNLOAD=true
PUSH_ENABLED=false
# SMTP intentionally unset (no mail egress). Configure only via an approved relay.

# ---- WebSocket notifications (served in-process at /notifications/hub) ----
# No extra config needed; Caddy passes the upgrade through.
