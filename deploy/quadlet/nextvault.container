[Unit]
Description=Vaultwarden (NIST 800-53B Moderate hardened fork)
Requires=nextvault-data-volume.service nextvault-internal-network.service nextvault-postgres.service
After=nextvault-data-volume.service nextvault-internal-network.service nextvault-postgres.service
# SSO (Entra) egress goes through the allowlist proxy. Want it up first so the
# first SSO login does not race the proxy; not a hard Requires (the app serves
# without it, SSO just fails until the proxy is up).
Wants=nextvault-egress-proxy.service
After=nextvault-egress-proxy.service

[Container]
ContainerName=nextvault
# Built locally from this fork (see deploy/scripts/build-image.sh).
# NIST CM-2/SR: pinned by immutable per-build tag (short image ID). A local-only
# image has no registry digest, so @sha256 pinning can't work; each deploy
# retags the new build and updates this line deliberately. AutoUpdate was
# removed for the same reason — updates must be explicit quadlet edits.
# Image ID: sha256:9985541d74dee240bd8ab4a9481d5e97ab73704678e852b97a8c8ea2f0d7d97a
Image=localhost/nextvault:9985541d
# Static internal IP. The container name "nextvault" collides with the VM
# hostname (host /etc/hosts maps 127.0.1.1 nextvault, which podman copies into
# every container and shadows aardvark-DNS), so Caddy must target the app by IP,
# not name. Mirrors the egress-proxy's static-IP approach.
Network=nextvault-internal.network:ip=10.89.10.10

# Non-secret configuration as code (NIST CM).
EnvironmentFile=%h/vaultwarden/config/vaultwarden.env

# Secrets mounted as files; Vaultwarden's native <KEY>_FILE support
# (util.rs get_env_str_value) reads the value from the file path. No shim needed.
Secret=vw_admin_token,type=mount,target=/run/secrets/vw_admin_token,mode=0400
Secret=vw_database_url,type=mount,target=/run/secrets/vw_database_url,mode=0400
Environment=ADMIN_TOKEN_FILE=/run/secrets/vw_admin_token
Environment=DATABASE_URL_FILE=/run/secrets/vw_database_url
# SSO (Entra) client secret as a podman secret, read via native <KEY>_FILE.
# Operator-set (never by tooling), same posture as ADMIN_TOKEN.
Secret=vw_sso_client_secret,type=mount,target=/run/secrets/vw_sso_client_secret,mode=0400
Environment=SSO_CLIENT_SECRET_FILE=/run/secrets/vw_sso_client_secret

# Route the app's outbound OIDC (reqwest) calls through the egress allowlist
# proxy (NIST SC-7). The app stays on the no-egress internal network and reaches
# the proxy at its static internal IP. NO_PROXY covers internal targets (the
# Postgres connection is raw TCP and unaffected by these anyway).
Environment=HTTP_PROXY=http://10.89.10.200:8888
Environment=HTTPS_PROXY=http://10.89.10.200:8888
Environment=NO_PROXY=localhost,127.0.0.1,nextvault-postgres,10.89.10.0/24

Volume=nextvault-data.volume:/data:Z
# Internal CA cert so the app validates the PostgreSQL server cert (sslmode=verify-full).
Volume=%h/vaultwarden/tls/ca/internal-ca.crt:/etc/ssl/certs/internal-ca.crt:ro,Z

# --- Hardening (NIST AC-6/SC) ---
# Rootless podman maps container UID 0 to an unprivileged host UID via user
# namespaces, so there is NO host root. With all capabilities dropped the app
# cannot bind <1024, so it listens on 8080 (set in vaultwarden.env); Caddy
# upstreams to vw:8080. /data is the only writable persistent path.
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=64m
PodmanArgs=--memory=512m --cpus=1.0

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
