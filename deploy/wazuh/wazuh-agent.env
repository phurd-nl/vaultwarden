# Wazuh agent connection settings (NIST AU-6 log shipping, SI-4 monitoring).
# Non-secret config-as-code. The enrollment PASSWORD is a podman secret
# (vw_wazuh_enrollment_key), NOT set here (NIST IA-5).
#
# EDIT every value below before deploy.

# DNS name or IP of the Wazuh manager that receives events and runs the rules.
# This is where alerts surface (Wazuh dashboard / your SIEM). Reachable from the
# edge network only; the manager lives OUTSIDE this host (see README.md).
WAZUH_MANAGER=wazuh-manager.example.com

# Manager that handles agent auto-enrollment (usually same host as WAZUH_MANAGER).
WAZUH_REGISTRATION_SERVER=wazuh-manager.example.com

# Tell the agent to read the shared enrollment password from the mounted secret
# instead of an env value (keeps the key out of the process environment).
WAZUH_REGISTRATION_PASSWORD_PATH=/run/secrets/vw_wazuh_enrollment_key

# How this agent identifies itself in the manager. Use a stable per-host name so
# alerts are attributable to this Vaultwarden node (NIST AU-3 source identity).
WAZUH_AGENT_NAME=vaultwarden-prod-01

# Manager-side group whose centralized config/rules this agent inherits.
WAZUH_AGENT_GROUP=vaultwarden
